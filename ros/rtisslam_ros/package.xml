<?xml version="1.0"?>
<package format="3">
  <name>rtisslam_ros</name>
  <version>0.1.0</version>
  <description>RTISSLAM ROS 2 nodes: eRTIS simulator, imaging, RTISSLAM (BatSLAM 2.0 pose graph + occupancy grid), navigator with the acoustic-flow controller.</description>
  <maintainer email="jan.steckel@uantwerpen.be">Jan Steckel</maintainer>
  <license>BSD-3-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rtis_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
